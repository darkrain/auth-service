{
  "Host": "",
  "Port": "8080",
  "PasswordSalt": "changeme_random_secret",
  "PasswordMinLength": 8,
  "PasswordRequireDigits": true,
  "PasswordRequireSpecial": false,
  "SystemUserEmail": "system@auth.internal",
  "SystemUserPassword": "changeme_system_password",
  "PostgreSqlHost": "localhost",
  "PostgreSqlPort": "5432",
  "PostgreSqlUserName": "username",
  "PostgreSqlPassword": "",
  "PostgreSqlDatabase": "db",
  "RedisDatabaseNetwork": "tcp",
  "RedisDatabaseHost": "localhost",
  "RedisDatabasePort": "6380",
  "RedisPassword": "superredispassword",
  "MessageBroker": {
    "Host": "localhost:5672",
    "User": "guest",
    "Password": "guest",
    "ExchangeName": "messages.events",
    "ExchangeKind": "topic",
    "PublishMode": "required",
    "RoutingKeys": {
      "DeliveryRequested": "message.delivery.requested"
    }
  },
  "CodeDelivery": {
    "Email": {
      "DefaultProvider": "email",
      "AllowedProviders": ["email"]
    },
