  "PostgreSQLSSLMode": "require",
  "SwaggerEnabled": false,
  "TestAccounts": [],
  "AllowedRoles": ["model", "manager", "agency"],
  "RateLimit": {
    "IP": {
      "LoginMaxAttempts": 5,
      "LoginWindowSec": 900,
      "RegisterMaxAttempts": 3,
      "RegisterWindowSec": 3600,
      "SendCodeMaxAttempts": 10,
      "SendCodeWindowSec": 60
    },
    "Device": {
      "LoginMaxAttempts": 10,
      "LoginWindowSec": 3600,
      "SendCodeMaxAttempts": 3,
      "SendCodeWindowSec": 3600,
      "RegisterMaxAttempts": 3,
      "RegisterWindowSec": 86400
    },
    "Account": {
      "MaxFailedLogins": 5,
      "LockDurationSec": 900
    },
    "Code": {
      "MaxAttempts": 5,
      "TTLSec": 300
    }
  }
